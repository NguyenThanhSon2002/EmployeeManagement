# Root Environment Variables Configuration for Local Development & Docker Compose

# Database (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hrms_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Backend Security
JWT_SECRET=your_base64_256bit_jwt_secret_key_here
SERVER_PORT=8080

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
VITE_USE_MOCK=false
VITE_DEFAULT_AUTH_PASSWORD=Admin@123
FRONTEND_PORT=5173
