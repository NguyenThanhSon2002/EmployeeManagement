# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual environment parameters.
# NEVER commit .env with production credentials to source control!
# ==============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hrms_db
DB_USER=root
DB_PASSWORD=your_secure_db_password_here

# JWT Security Configuration
# Generate a secure 256-bit key using: openssl rand -base64 32
JWT_SECRET=your_base64_256bit_jwt_secret_here

# Application Server Ports
SERVER_PORT=8080
FRONTEND_PORT=5173
